<Window x:Class="WinSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinSetup.UI"
        Title="Talia" Icon="Talia.ico"
        Width="1280" Height="800" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushObsidian}" Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource TaliaFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ui:StatusKindConverter x:Key="StatusKind"/>
        <ui:StatusBrushConverter x:Key="StatusBrush"/>
        <ui:NameInitialConverter x:Key="Initial"/>
        <ui:NameTintConverter x:Key="Tint"/>
        <ui:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>

        <!-- Small ghost buttons shown only on user-defined catalog entries -->
        <Style x:Key="CustomOnlyGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CustomOnlyGhostDanger" TargetType="Button" BasedOn="{StaticResource GhostDangerButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Catalog card -->
        <DataTemplate x:Key="AppCardTemplate">
            <Border Width="{DynamicResource CardWidth}" Height="150" Margin="0,0,12,12" Padding="14,12" BorderThickness="1" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BrushSurface1}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource BrushSilverLine}"/></Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushCardSelected}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrushPinkLine}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status, Converter={StaticResource StatusKind}}" Value="Error">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushRed}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{Binding Name, Converter={StaticResource Tint}, ConverterParameter=bg}">
                            <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Name, Converter={StaticResource Tint}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource BrushIcy}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="Выбрать для установки"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,10,0,0" ToolTip="{Binding Description}"/>
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=text}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                                <TextBlock Grid.Column="2" Text="{Binding InstalledVersion}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding InstalledPath}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstalledPath}" Margin="14,2,0,0" Visibility="{Binding InstalledPath, Converter={StaticResource EmptyToCollapsed}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,0">
                            <Button Content="Изменить" Style="{StaticResource CustomOnlyGhost}" Click="EditCustomApp_Click"/>
                            <Button Content="Удалить" Style="{StaticResource CustomOnlyGhostDanger}" Click="DeleteCustomApp_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Installed row -->
        <DataTemplate x:Key="InstalledRowTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,12,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BrushSkin}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Verified}" Value="True"><Setter Property="Fill" Value="{StaticResource BrushPink}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                            <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="{StaticResource BrushIcy}" FontSize="12" Margin="10,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <TextBlock Text="{Binding Path=Path}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path=Path}" Margin="0,3,0,0" Visibility="{Binding Path=Path, Converter={StaticResource EmptyToCollapsed}}"/>
                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                        <Border Background="{StaticResource BrushPinkSoft}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right" Visibility="{Binding CatalogLabel, Converter={StaticResource EmptyToCollapsed}}">
                            <TextBlock Text="{Binding CatalogLabel}" FontSize="11" Foreground="{StaticResource BrushText}"/>
                        </Border>
                        <Button Content="Открыть папку" Style="{StaticResource GhostButton}" Margin="0,4,0,0" HorizontalAlignment="Right" Click="OpenInstalledFolder_Click" Visibility="{Binding Path=Path, Converter={StaticResource EmptyToCollapsed}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Queue row -->
        <DataTemplate x:Key="QueueRowTemplate">
            <Border Margin="0,0,0,8" Padding="14,10">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status, Converter={StaticResource StatusKind}}" Value="Error">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushRed}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status, Converter={StaticResource StatusKind}}" Value="Working">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushPinkLine}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top" Background="{Binding Name, Converter={StaticResource Tint}, ConverterParameter=bg}">
                        <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Name, Converter={StaticResource Tint}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" VerticalAlignment="Top" Margin="0,5,7,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=text}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{Binding InstalledPath}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstalledPath}" Margin="14,3,0,0" Visibility="{Binding InstalledPath, Converter={StaticResource EmptyToCollapsed}}"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=text}" FontSize="12" TextWrapping="Wrap" Margin="14,6,0,0" Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsed}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Quiet atmosphere: two static gradients, no animation -->
        <Rectangle Fill="{StaticResource BrushAtmospherePink}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource BrushAtmosphereIcy}" IsHitTestVisible="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== SIDEBAR ===================== -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurface1}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,16,12,14" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                        <Grid Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource BrushObsidian}" BorderBrush="{StaticResource BrushSilverLine}" BorderThickness="1" VerticalAlignment="Center">
                                <Grid Width="14" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M0,0 H18 V3.6 H10.8 V18 H7.2 V3.6 H0 Z" Fill="{StaticResource BrushPink}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Top"/>
                                    <Rectangle Width="8" Height="1.5" Fill="{StaticResource BrushSilver}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource NavLabelVisibility}">
                                <TextBlock Text="Talia" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Install. Organize. Enjoy." FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="Talia 1.0.0" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="6,12,0,0" Visibility="{DynamicResource NavLabelVisibility}"/>

                    <StackPanel>
                        <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Главная" ToolTip="Главная" Click="Nav_Click"/>
                        <RadioButton x:Name="NavPrograms" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE71D;" Content="Программы" ToolTip="Каталог программ" Click="Nav_Click"/>
                        <RadioButton x:Name="NavInstalled" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE73E;" Content="Установленные" ToolTip="Программы, найденные в системе" Click="Nav_Click"/>
                        <RadioButton x:Name="NavQueue" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE896;" Content="Очередь" ToolTip="Очередь установки" Click="Nav_Click"/>
                        <RadioButton x:Name="NavProfiles" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE716;" Content="Профили" ToolTip="Профили установки" Click="Nav_Click"/>
                        <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Настройки" ToolTip="Инструменты и настройки" Click="Nav_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===================== CONTENT ===================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="ViewHost" Grid.Row="0">

                    <!-- VIEW: HOME -->
                    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,32,32,16" MaxWidth="900">
                            <TextBlock Text="Talia" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Install. Organize. Enjoy." FontSize="13" Foreground="{StaticResource BrushPink}" Margin="0,2,0,0"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,14,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                       Text="Выбери программы в каталоге, укажи папку для установки — Talia поставит всё через WinGet и покажет результат по каждой программе."/>
                            <Button Content="Открыть каталог программ" Style="{StaticResource PrimaryButton}" Padding="22,11" HorizontalAlignment="Left" Margin="0,20,0,0" Click="GoPrograms_Click"/>

                            <Grid Margin="0,32,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Папка установки" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="HomeRootText" Text="Корневая папка программ: не задана" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                                        <TextBlock Text="Для каждой программы создаётся отдельная папка внутри выбранной." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <Button Content="Изменить папку" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ChooseInstallRoot_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Состояние" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="HomeCatalogText" Text="Программ в каталоге: 0" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="HomeSelectedText" Text="Выбрано: 0" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                                        <Button Content="Проверить WinGet" HorizontalAlignment="Left" Margin="0,14,0,0" Click="CheckWinget_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- VIEW: PROGRAMS -->
                    <Grid x:Name="ProgramsView" Visibility="Collapsed" Margin="28,26,28,0" MaxWidth="1560">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Программы" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Отметь нужные приложения — Talia подготовит установку." Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Выбрано" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="SelectedCount" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushPink}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SelectedHiddenText" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="Выбранные программы, скрытые текущим поиском или категорией, остаются выбранными"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Height="40" Tag="Поиск по названию, описанию или категории" ToolTip="Поиск по названию, описанию и категории" AutomationProperties.Name="Поиск программ" TextChanged="SearchBox_TextChanged"/>
                            <Button x:Name="SortButton" Grid.Column="1" Content="Порядок: каталог" Height="40" Padding="14,0" Margin="10,0,0,0" ToolTip="Сменить сортировку: каталог / название / категория" Click="Sort_Click"/>
                            <Button Grid.Column="2" Content="+ Добавить программу" Height="40" Padding="16,0" Margin="10,0,0,0" Click="AddApp_Click"/>
                        </Grid>
                        <WrapPanel x:Name="CategoryPanel" Grid.Row="2" Margin="0,0,0,6"/>
                        <ScrollViewer x:Name="CatalogScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="CatalogScroll_SizeChanged">
                            <StackPanel>
                                <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource AppCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="CatalogEmptyText" Text="Ничего не найдено. Измени запрос или выбери другую категорию." Style="{StaticResource SecondaryText}" Margin="2,16,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW: INSTALLED -->
                    <Grid x:Name="InstalledView" Visibility="Collapsed" Margin="28,26,28,0" MaxWidth="1200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Установленные программы" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="InstalledSummaryText" Text="Список строится по реестру Windows. Нажми «Обновить»." Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                            <Button x:Name="InstalledRefreshButton" Grid.Column="1" Content="Обновить" VerticalAlignment="Center" Click="RefreshInstalled_Click"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstalledSearchBox" Height="40" Tag="Поиск среди установленных программ" AutomationProperties.Name="Поиск установленных программ" TextChanged="InstalledSearchBox_TextChanged"/>
                            <CheckBox x:Name="InstalledOnlyVerified" Grid.Column="1" Content="Только подтверждённые" Margin="14,0,0,0" ToolTip="Скрыть записи, для которых исполняемый файл на диске не найден" Foreground="{StaticResource BrushTextSecondary}" Click="InstalledFilter_Click"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <ItemsControl x:Name="InstalledList" ItemTemplate="{StaticResource InstalledRowTemplate}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="InstalledEmptyText" Style="{StaticResource SecondaryText}" Margin="2,8,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>

                    <!-- VIEW: QUEUE -->
                    <Grid x:Name="QueueView" Visibility="Collapsed" Margin="32,26,32,0" MaxWidth="1000">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Очередь установки" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Состояние каждой программы и подробности ошибок." Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Повторить ошибки" Margin="0,0,8,0" Click="RetryFailed_Click"/>
                                <Button Content="Журнал" Click="OpenLog_Click"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border x:Name="QueueSummaryCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="QueueProgressText" Style="{StaticResource SectionTitle}"/>
                                                <TextBlock x:Name="QueueCurrentText" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button x:Name="QueueCancelButton" Grid.Column="1" Content="Отмена" VerticalAlignment="Center" IsEnabled="False" Click="CancelInstall_Click"/>
                                        </Grid>
                                        <ProgressBar x:Name="QueueProgress" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="QueueSummaryText" Style="{StaticResource BodyText}" Margin="0,12,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource QueueRowTemplate}"/>
                                <TextBlock x:Name="QueueEmptyText" Text="Очередь пуста. Отметь программы в каталоге и нажми «Установить выбранное»." Style="{StaticResource SecondaryText}" Margin="2,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW: PROFILES -->
                    <ScrollViewer x:Name="ProfilesView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,26,32,16" MaxWidth="900">
                            <TextBlock Text="Профили установки" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Сохрани текущий выбор программ как набор и загружай его в один клик." Style="{StaticResource PageSubtitle}"/>
                            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Сохранённые наборы" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <ListBox x:Name="ProfileCombo" MinHeight="140" MaxHeight="320" Background="{StaticResource BrushSurface2}"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="Загрузить" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="LoadProfile_Click"/>
                                        <Button Content="Сохранить набор" Margin="0,0,8,8" Click="SaveProfile_Click"/>
                                        <Button Content="Экспорт…" Margin="0,0,8,8" ToolTip="Сохранить выбранный профиль в файл JSON" Click="ExportProfile_Click"/>
                                        <Button Content="Импорт…" Margin="0,0,8,8" ToolTip="Загрузить профили из файла JSON" Click="ImportProfile_Click"/>
                                        <Button Content="Удалить профиль" Style="{StaticResource DangerButton}" Margin="0,0,0,8" Click="DeleteProfile_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- VIEW: SETTINGS -->
                    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,26,32,16" MaxWidth="900">
                            <TextBlock Text="Инструменты и настройки" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="WinGet, проверка программ, папки и журнал установки." Style="{StaticResource PageSubtitle}"/>

                            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="WinGet" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Проверь готовность WinGet или установи официальный App Installer (подпись Microsoft проверяется перед запуском)." Style="{StaticResource SecondaryText}" Margin="0,4,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="WingetCheckButton" Content="Проверить WinGet" Margin="0,0,8,0" Click="CheckWinget_Click"/>
                                        <Button x:Name="WingetBootstrapButton" Content="Установить WinGet" Click="InstallWinget_Click" ToolTip="Скачать официальный App Installer от Microsoft и проверить его цифровую подпись"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Программы" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Проверь, какие программы из каталога уже установлены, или повтори установку тех, что завершились ошибкой." Style="{StaticResource SecondaryText}" Margin="0,4,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="InstalledCheckButton" Content="Проверить программы" Margin="0,0,8,0" Click="CheckInstalled_Click"/>
                                        <Button Content="Повторить ошибки" Click="RetryFailed_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Папки" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Корневая папка программ задаёт, где появятся отдельные папки установки. «Создать папки» только создаёт каталоги и не переносит файлы." Style="{StaticResource SecondaryText}" Margin="0,4,0,12"/>
                                    <WrapPanel>
                                        <Button Content="Папка программ" Margin="0,0,8,8" Click="ChooseInstallRoot_Click"/>
                                        <Button Content="Пути и папки" Margin="0,0,8,8" Click="Folders_Click"/>
                                        <Button Content="Создать папки" Margin="0,0,0,8" Click="CreateFolders_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Журнал" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Подробный журнал последней установки открывается в текстовом редакторе по умолчанию." Style="{StaticResource SecondaryText}" Margin="0,4,0,12"/>
                                    <Button Content="Открыть журнал" HorizontalAlignment="Left" Click="OpenLog_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Talia 1.0.0 · Install. Organize. Enjoy." Style="{StaticResource CaptionText}" Margin="2,16,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===================== FOOTER / STATUS ===================== -->
                <Border Grid.Row="1" Background="{StaticResource BrushSurface1}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                    <Grid Margin="24,12,24,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Name="StatusText" Text="Готов к работе" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DetailStatusText" Text="Выбери приложения и запусти установку" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" MaxHeight="34" Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <ProgressBar x:Name="InstallProgress" Margin="0,9,0,0"/>
                            <TextBlock x:Name="InstallRootText" Text="Корневая папка программ: не задана" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CancelButton" Content="Отмена" Height="40" Padding="18,0" Margin="0,0,8,0" Click="CancelInstall_Click" IsEnabled="False"/>
                            <Button x:Name="InstallButton" Content="Установить выбранное" Style="{StaticResource PrimaryButton}" Height="40" Padding="20,0" Click="Install_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
