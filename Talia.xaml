<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- ===================== COLORS (Talia palette) ===================== -->
    <Color x:Key="ColorObsidian">#0B0B10</Color>
    <Color x:Key="ColorPink">#E99BC5</Color>
    <Color x:Key="ColorSilver">#C8CDD8</Color>
    <Color x:Key="ColorRed">#A83250</Color>
    <Color x:Key="ColorIcy">#9BAEDC</Color>
    <Color x:Key="ColorSkin">#D9A99B</Color>

    <Color x:Key="ColorSurface1">#131319</Color>
    <Color x:Key="ColorSurface2">#191920</Color>
    <Color x:Key="ColorSurface3">#202027</Color>
    <Color x:Key="ColorBorder">#303039</Color>
    <Color x:Key="ColorText">#F2EFF3</Color>
    <Color x:Key="ColorTextSecondary">#A5A1AA</Color>
    <Color x:Key="ColorTextMuted">#77737E</Color>

    <!-- ===================== BRUSHES ===================== -->
    <SolidColorBrush x:Key="BrushObsidian" Color="{StaticResource ColorObsidian}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushPink" Color="{StaticResource ColorPink}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushPinkDeep" Color="#D585B0" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushPinkSoft" Color="#26E99BC5" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushPinkLine" Color="#99E99BC5" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushSilver" Color="{StaticResource ColorSilver}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushSilverLine" Color="#55C8CDD8" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushRed" Color="{StaticResource ColorRed}" po:Freeze="True"/>
    <!-- Lightened Deep Red used only for error TEXT so it stays readable on dark surfaces -->
    <SolidColorBrush x:Key="BrushRedText" Color="#E57A93" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushIcy" Color="{StaticResource ColorIcy}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushSkin" Color="{StaticResource ColorSkin}" po:Freeze="True"/>

    <SolidColorBrush x:Key="BrushSurface1" Color="{StaticResource ColorSurface1}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushSurface2" Color="{StaticResource ColorSurface2}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushSurface3" Color="{StaticResource ColorSurface3}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushCardSelected" Color="#241E27" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushScrollThumb" Color="#44C8CDD8" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrushScrollThumbHover" Color="#88C8CDD8" po:Freeze="True"/>

    <!-- ===================== ATMOSPHERE (static, cheap) ===================== -->
    <RadialGradientBrush x:Key="BrushAtmospherePink" Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.75" RadiusY="0.9" po:Freeze="True">
        <GradientStop Color="#1CE99BC5" Offset="0"/>
        <GradientStop Color="#00E99BC5" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BrushAtmosphereIcy" Center="1,1" GradientOrigin="1,1" RadiusX="0.6" RadiusY="0.7" po:Freeze="True">
        <GradientStop Color="#0E9BAEDC" Offset="0"/>
        <GradientStop Color="#009BAEDC" Offset="1"/>
    </RadialGradientBrush>

    <!-- ===================== SHAPE / TYPE TOKENS ===================== -->
    <CornerRadius x:Key="RadiusS">6</CornerRadius>
    <CornerRadius x:Key="RadiusM">8</CornerRadius>
    <CornerRadius x:Key="RadiusL">12</CornerRadius>

    <FontFamily x:Key="TaliaFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="TaliaIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizePage">24</sys:Double>
    <sys:Double x:Key="FontSizeSection">15</sys:Double>
    <sys:Double x:Key="FontSizeCard">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>

    <!-- ===================== TEXT STYLES ===================== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizePage}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ===================== SURFACES ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSurface1}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusL}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ===================== BUTTONS ===================== -->
    <ControlTemplate x:Key="TaliaButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusM}"/>
            <Border x:Name="Hover" Background="#22FFFFFF" CornerRadius="{StaticResource RadiusM}" Opacity="0" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushPink}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Secondary: dark surface + thin Chrome Silver border. Also the implicit Button style. -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushSilverLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource TaliaButtonTemplate}"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource BrushObsidian}"/>
        <Setter Property="Background" Value="{StaticResource BrushPink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushPink}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource BrushRedText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushRed}"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    </Style>
    <Style x:Key="GhostDangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource BrushRedText}"/>
    </Style>

    <!-- Category chips -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style x:Key="ChipButtonActive" TargetType="Button" BasedOn="{StaticResource ChipButton}">
        <Setter Property="Background" Value="{StaticResource BrushPinkSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushPinkLine}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    </Style>

    <!-- Navigation item (RadioButton). Tag = icon glyph, Content = label. -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="12,9" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource BrushPink}" HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource TaliaIconFont}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{DynamicResource NavLabelVisibility}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurface2}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPinkSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushSilverLine}"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource BrushPink}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushPink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== INPUTS ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushSilverLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushPink}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BrushPink}"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusM}" SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource BrushTextMuted}" FontSize="{TemplateBinding FontSize}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushSilver}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushPink}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="{StaticResource RadiusS}" BorderThickness="1.5" BorderBrush="{StaticResource BrushSilverLine}" Background="{StaticResource BrushSurface2}" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M1,5 L4.5,8.5 L11,1.5" Stretch="Uniform" Margin="3.5" Stroke="{StaticResource BrushObsidian}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter x:Name="Cp" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Cp" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushPink}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushPink}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushPink}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushPink}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== LISTS ===================== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource BrushSurface1}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusM}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource RadiusS}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurface2}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPinkSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushPinkLine}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== SCROLLBAR ===================== -->
    <Style x:Key="TaliaScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Th" Background="{StaticResource BrushScrollThumb}" CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="{StaticResource BrushScrollThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="{StaticResource BrushScrollThumbHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TaliaScrollRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="TaliaScrollVertical" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,0">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource TaliaScrollRepeat}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource TaliaScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource TaliaScrollRepeat}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="TaliaScrollHorizontal" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="0,2">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource TaliaScrollRepeat}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource TaliaScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource TaliaScrollRepeat}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template" Value="{StaticResource TaliaScrollVertical}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template" Value="{StaticResource TaliaScrollHorizontal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== PROGRESS ===================== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{StaticResource BrushBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPink}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TOOLTIP ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="Background" Value="{StaticResource BrushSurface3}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushSilverLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusS}" Padding="{TemplateBinding Padding}" MaxWidth="480">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Layout-driven resources, updated from code-behind on resize -->
    <Visibility x:Key="NavLabelVisibility">Visible</Visibility>
    <sys:Double x:Key="CardWidth">320</sys:Double>
</ResourceDictionary>
