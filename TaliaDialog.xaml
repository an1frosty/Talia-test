<Window x:Class="WinSetup.TaliaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Talia" Icon="Talia.ico"
        SizeToContent="WidthAndHeight" MinWidth="360" MaxWidth="540"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BrushObsidian}" Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource TaliaFont}" FontSize="13" UseLayoutRounding="True"
        PreviewKeyDown="Dialog_PreviewKeyDown">
    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,0" Background="{StaticResource BrushSurface1}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Rectangle x:Name="AccentBar" Height="2" Fill="{StaticResource BrushPink}" VerticalAlignment="Top"/>
            <StackPanel Grid.Row="0" Margin="24,22,24,0">
                <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24,10,24,0" MaxHeight="420">
                <StackPanel>
                    <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"/>
                    <TextBox x:Name="InputBox" Margin="0,14,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="ButtonRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,20,24,22"/>
        </Grid>
    </Border>
</Window>
