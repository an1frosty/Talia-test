<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinSetup</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Talia</Product>
    <AssemblyTitle>Talia</AssemblyTitle>
    <Description>Talia — install. organize. enjoy.</Description>
    <ApplicationIcon>Talia.ico</ApplicationIcon>
    <RootNamespace>WinSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Talia.ico" />
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>
</Project>
